    "accepted": true,
    "note": "just the path"
  },
  {
    "id": "ps-svc-account",
    "text": "Get-CimInstance -ClassName Win32_Service | select StartName, Name, StartMode",
    "accepted": true,
    "note": "the class named, select, another order"
  },
  {
    "id": "ps-user-pw-never",
    "text": "Get-LocalUser | where PasswordExpires -eq $null",
    "accepted": true,
    "note": "the short form"
  },
  {
    "id": "ps-acl-everyone",
    "text": "(Get-Acl C:\\Shares\\Finance).Access | ? { $_.IdentityReference -eq 'Everyone' }",
    "accepted": true,
    "note": "a script block with ?"
  },
  {
    "id": "ps-task-nonmicrosoft",
    "text": "Get-ScheduledTask | where { $_.TaskPath -notlike '\\Microsoft\\*' }",
    "accepted": true,
    "note": "a script block with where"
  }
]
